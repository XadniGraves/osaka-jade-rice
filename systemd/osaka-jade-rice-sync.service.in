[Unit]
Description=Watch, version, and push Osaka Jade rice changes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/scripts/watch.sh
Restart=always
RestartSec=30
Environment=GIT_TERMINAL_PROMPT=0

[Install]
WantedBy=default.target
