{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Only height is specified so Fastfetch preserves each sprite's
  // original aspect ratio.
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/undead-current.png",
    "height": 14,
    "recache": true,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      // Category labels stay readable against the Osaka Jade wallpaper.
      "keys": "#8FB7A4",
      // undead-fetch overrides this fallback to match the selected sprite.
      "title": "#C084FC",
      "output": "#E5E7EB",
      "separator": "#6B7280"
    },
    "key": {
      "width": 8,
      "type": "string"
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "  ▄▀█ █▀█ █▀▀ █░█   █░░ █ █▀▀ █░█",
      "outputColor": "title"
    },
    {
      "type": "custom",
      "format": "  █▀█ █▀▄ █▄▄ █▀█   █▄▄ █ █▄▄ █▀█",
      "outputColor": "title"
    },
    {
      "type": "custom",
      "format": "{##6F8E83}     ── xadni's phylactery ──{#}"
    },

    "break",

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "battery",
      "key": "Battery"
    }
  ]
}
