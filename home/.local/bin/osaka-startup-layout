#!/usr/bin/env bash

set -Eeuo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/osaka-jade-rice"
LOG_FILE="$STATE_DIR/startup-layout.log"
LOCK_FILE="$STATE_DIR/startup-layout.lock"
WELCOME_CONFIG="$HOME/.config/omarchy/welcome.json"
KITTY_SESSION="$HOME/.config/kitty/startup-workspace-2.session"

mkdir -p -- "$STATE_DIR"
exec >>"$LOG_FILE" 2>&1

echo "$(date --iso-8601=seconds) startup layout requested"

for command_name in flock hyprctl jq uwsm-app; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "Required command is unavailable: $command_name"
    exit 1
  }
done

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Startup layout is already running; skipping duplicate request."
  exit 0
fi

client_exists() {
  local class_pattern="$1"

  hyprctl -j clients 2>/dev/null |
    jq -e --arg pattern "$class_pattern" 'any(.[]; .class | test($pattern))' >/dev/null 2>&1
}

wait_for_client() {
  local class_pattern="$1"

  for _attempt in {1..50}; do
    client_exists "$class_pattern" && return 0
    sleep 0.2
  done
  return 1
}

launch_client() {
  local class_pattern="$1"
  local label="$2"
  local executable="$3"
  shift 3

  if client_exists "$class_pattern"; then
    echo "$label already has a window; leaving it in place."
    return 0
  fi
  if ! command -v "$executable" >/dev/null 2>&1; then
    echo "$label skipped because $executable is not installed."
    return 0
  fi

  echo "Launching $label."
  uwsm-app -- "$executable" "$@" >/dev/null 2>&1 &
}

wait_for_welcome_to_close() {
  local state=""
  local saw_open=0

  if [[ -f "$WELCOME_CONFIG" ]] && jq -e '.enabled == false' "$WELCOME_CONFIG" >/dev/null 2>&1; then
    echo "Welcome overlay is disabled; continuing without waiting."
    return 0
  fi

  for _attempt in {1..80}; do
    state="$(omarchy shell welcome state 2>/dev/null || true)"
    if [[ "$state" == "open" ]]; then
      saw_open=1
    elif ((saw_open)) && [[ "$state" == "closed" ]]; then
      echo "Welcome overlay closed."
      return 0
    fi
    sleep 0.25
  done

  echo "Welcome overlay wait timed out; continuing with Codex."
}

# Begin on an empty workspace 3. Every other launch is assigned with a silent
# rule so it can populate in the background without stealing focus.
hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })' >/dev/null

launch_client "(spotify|Spotify)" "Spotify" spotify

if [[ -f "$KITTY_SESSION" ]]; then
  launch_client \
    "org\\.omarchy\\.startup-terminal" \
    "workspace 2 shell and Cava" \
    kitty \
    --class org.omarchy.startup-terminal \
    --title "Workspace 2" \
    --session "$KITTY_SESSION"
  wait_for_client "org\\.omarchy\\.startup-terminal" || \
    echo "Workspace 2 shell did not appear before the timeout."
else
  echo "Kitty session is missing: $KITTY_SESSION"
fi

launch_client \
  "org\\.omarchy\\.startup-btop" \
  "workspace 2 btop" \
  kitty \
  --class org.omarchy.startup-btop \
  --title "btop" \
  btop

launch_client "(vesktop|Vesktop)" "Vesktop" vesktop
launch_client "steam.*" "Steam" steam

wait_for_welcome_to_close
sleep 1

launch_client \
  "org\\.omarchy\\.startup-codex" \
  "Codex" \
  kitty \
  --class org.omarchy.startup-codex \
  --title "Codex" \
  --directory "$HOME/Work" \
  codex

wait_for_client "org\\.omarchy\\.startup-codex" || \
  echo "Codex did not appear before the timeout."

hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })' >/dev/null
hyprctl dispatch 'hl.dsp.focus({ window = "class:org.omarchy.startup-codex" })' >/dev/null 2>&1 || true
echo "$(date --iso-8601=seconds) startup layout complete"
