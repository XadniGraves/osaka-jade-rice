#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG_DIR="$HOME/.config/omarchy"
CONFIG_FILE="$CONFIG_DIR/welcome.json"
PLUGIN_DIR="$CONFIG_DIR/plugins/xadni.welcome"
ASSET_DIR="$PLUGIN_DIR/assets"
DEFAULT_MESSAGE="Welcome back, Commander."
DEFAULT_IMAGE="assets/ghost-ai-executive.png"

usage() {
  cat <<'EOF'
Usage:
  welcome                         Preview the welcome overlay
  welcome --show                  Preview the welcome overlay
  welcome --edit "Message"        Save and preview a new message
  welcome --enable                Enable the automatic boot greeting
  welcome --disable               Disable the automatic boot greeting
  welcome --image PATH            Copy, select, and preview a custom portrait
  welcome --no-image              Hide the portrait
  welcome --reset-image           Restore Ghost's default portrait
  welcome --get                   Print the current message
  welcome --status                Print the enabled state, message, and portrait
  welcome --reset                 Restore the default message and preview it
  welcome --help, -h              Show this help
EOF
}

current_message() {
  local value=""

  if [[ -f "$CONFIG_FILE" ]]; then
    value="$(jq -er '.message | select(type == "string")' "$CONFIG_FILE" 2>/dev/null || true)"
  fi
  printf '%s\n' "${value:-$DEFAULT_MESSAGE}"
}

current_enabled() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo true
    return
  fi

  jq -r 'if .enabled == false then "false" else "true" end' "$CONFIG_FILE" 2>/dev/null || echo true
}

current_image() {
  if [[ -f "$CONFIG_FILE" ]] && jq -e '.image | type == "string"' "$CONFIG_FILE" >/dev/null 2>&1; then
    jq -r '.image' "$CONFIG_FILE"
  else
    printf '%s\n' "$DEFAULT_IMAGE"
  fi
}

preview() {
  if ! omarchy shell -q welcome preview >/dev/null 2>&1; then
    echo "Welcome settings saved, but the welcome plugin is not currently available." >&2
    echo "It will be used the next time the Omarchy desktop starts." >&2
  fi
}

write_config() {
  local value="$1"
  local enabled="$2"
  local image="$3"
  local temporary

  if [[ -z "${value//[[:space:]]/}" ]]; then
    echo "Welcome message cannot be empty." >&2
    exit 2
  fi
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "Welcome message must fit on one line." >&2
    exit 2
  fi
  if ((${#value} > 80)); then
    echo "Welcome message must be 80 characters or fewer." >&2
    exit 2
  fi

  mkdir -p -- "$CONFIG_DIR"
  temporary="$(mktemp "$CONFIG_DIR/.welcome.json.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  jq -n --arg message "$value" --argjson enabled "$enabled" --arg image "$image" \
    '{message: $message, enabled: $enabled, image: $image}' > "$temporary"
  chmod 0644 "$temporary"
  mv -- "$temporary" "$CONFIG_FILE"
  trap - RETURN
}

save_message() {
  local value="$1"

  write_config "$value" "$(current_enabled)" "$(current_image)"

  printf 'Welcome message updated: %s\n' "$value"
  preview
}

set_enabled() {
  local enabled="$1"

  write_config "$(current_message)" "$enabled" "$(current_image)"
  if [[ "$enabled" == true ]]; then
    echo "Welcome enabled for desktop startup."
    preview
  else
    echo "Welcome disabled for desktop startup."
    omarchy shell -q welcome close >/dev/null 2>&1 || true
  fi
}

save_image_setting() {
  local image="$1"
  local confirmation="$2"

  write_config "$(current_message)" "$(current_enabled)" "$image"
  echo "$confirmation"
  preview
}

install_image() {
  local source="$1"
  local extension target temporary

  [[ -f "$source" && -r "$source" ]] || {
    echo "Welcome image is not a readable file: $source" >&2
    exit 2
  }

  extension="${source##*.}"
  extension="${extension,,}"
  case "$extension" in
    png|jpg|jpeg|webp) ;;
    *)
      echo "Welcome image must be a PNG, JPG, JPEG, or WebP file." >&2
      exit 2
      ;;
  esac

  mkdir -p -- "$ASSET_DIR"
  target="$ASSET_DIR/custom-image.$extension"
  temporary="$(mktemp "$ASSET_DIR/.custom-image.XXXXXX")"
  trap 'rm -f -- "$temporary"' RETURN
  cp -- "$source" "$temporary"
  chmod 0644 "$temporary"
  mv -- "$temporary" "$target"
  trap - RETURN

  save_image_setting "assets/custom-image.$extension" "Welcome portrait updated: $source"
}

case "${1:---show}" in
  --show)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    omarchy shell welcome show
    ;;
  --edit|-e)
    shift
    (($#)) || { echo "--edit requires a message." >&2; exit 2; }
    save_message "$*"
    ;;
  --get)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    current_message
    ;;
  --enable)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    set_enabled true
    ;;
  --disable)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    set_enabled false
    ;;
  --image|-i)
    shift
    [[ $# -eq 1 ]] || { echo "--image requires exactly one file path." >&2; exit 2; }
    install_image "$1"
    ;;
  --no-image)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    save_image_setting "" "Welcome portrait hidden."
    ;;
  --reset-image)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    save_image_setting "$DEFAULT_IMAGE" "Ghost's welcome portrait restored."
    ;;
  --status)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    printf 'Enabled: %s\n' "$(current_enabled)"
    printf 'Message: %s\n' "$(current_message)"
    printf 'Image: %s\n' "$(current_image)"
    ;;
  --reset)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    save_message "$DEFAULT_MESSAGE"
    ;;
  --help|-h)
    usage
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
esac
